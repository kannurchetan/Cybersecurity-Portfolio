# Detect Nmap scan
alert tcp any any -> $HOME_NET any (msg:"NMAP Scan Detected"; flags:S; sid:1000001; rev:1;)

# Detect repeated ICMP ping
alert icmp any any -> $HOME_NET any (msg:"Suspicious ICMP Traffic"; itype:8; sid:1000002; rev:1;)

# Detect FTP brute-force attempts
alert tcp any any -> $HOME_NET 21 (msg:"FTP Brute Force"; flow:to_server,established; content:"USER"; sid:1000003; rev:1;)
